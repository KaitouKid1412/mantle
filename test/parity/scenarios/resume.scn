# Resume: -c continues the last session after a restart.
name: resume
size: 100x30
args: --permission-mode default
files: fixtures/app
script: scripts/resume.json
parity: SE-07, SE-08
---
ready
type Remember a word for me
keys enter
wait_for 30s kumquat
settle
restart -c
ready 20s
settle 3s
checkpoint resumed
type What was the word?
keys enter
wait_for 30s You asked me to remember kumquat.
settle
checkpoint continued
