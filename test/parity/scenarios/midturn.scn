# Mid-turn pickup: a message sent while a tool runs joins the turn at the tool
# boundary. The script answers the second request only when it carries both the tool
# result and the new message, so a target that queues the message as its own turn
# never shows the answer.
name: midturn
size: 100x30
args: --permission-mode default --allowedTools 'Bash(sleep:*)'
files: ../../../testdata/fixtures/12/app
script: scripts/midturn.json
settings: {"spinnerTipsEnabled": false}
parity: TC-06
---
ready
type Wait for the build
keys enter
wait_for 30s sleep 6
type Also check the tests
keys enter
settle 1s
checkpoint queued
wait_for 60s Folded in: build done, tests checked.
settle
checkpoint folded
